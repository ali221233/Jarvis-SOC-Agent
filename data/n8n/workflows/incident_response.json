{
  "name": "Jarvis — Incident Response Logger",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "incident_response",
        "responseMode": "responseNode"
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "mode": "url", "value": "" },
        "sheetName": { "mode": "name", "value": "Incidents" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Incident ID": "={{$json.body.incidentId}}",
            "Playbook": "={{$json.body.playbookName}}",
            "Steps Completed": "={{$json.body.stepsCompleted}}",
            "Timestamp": "={{$json.body.timestamp}}",
            "Session ID": "={{$json.body.sessionId}}"
          }
        }
      },
      "name": "Log to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"logged\": true}"
      },
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": { "main": [[{ "node": "Log to Google Sheets", "type": "main", "index": 0 }]] },
    "Log to Google Sheets": { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "tags": ["jarvis", "soc", "logging"]
}
