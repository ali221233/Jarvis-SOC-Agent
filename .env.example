# ============================================================
# Jarvis SOC Agent v3.0 — Environment Configuration
# ============================================================

# === REQUIRED ===
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# === OPTIONAL THREAT INTELLIGENCE ===
# All free tier. Multi-source enrichment uses all available keys.
ABUSEIPDB_API_KEY=        # https://abuseipdb.com → API tab
VIRUSTOTAL_API_KEY=       # https://virustotal.com → API key in profile
SHODAN_API_KEY=           # https://account.shodan.io → API key
URLSCAN_API_KEY=          # https://urlscan.io → Settings → API Keys
ALIENVAULT_API_KEY=       # https://otx.alienvault.com → Settings → API Integration
HIBP_API_KEY=             # https://haveibeenpwned.com/API/Key (paid, $3.50/month)

# === OPTIONAL ALERTING ===
# Gmail: use App Password, not your real password
# https://myaccount.google.com/apppasswords
EMAIL_FROM=your@gmail.com
EMAIL_TO=your@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Slack incoming webhook URL
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# === PHONE NOTIFICATIONS ===
# ntfy.sh — free, no account required
# Install the ntfy app on your phone, subscribe to your topic
NTFY_TOPIC=jarvis-your-unique-topic

# === OPTIONAL VOICE ===
JARVIS_VOICE=af_sky

# === OPTIONAL ANOMALY DETECTION ===
# Duration of baseline learning mode (in hours)
BASELINE_HOURS=24

# === SERVER ===
PORT=3000
